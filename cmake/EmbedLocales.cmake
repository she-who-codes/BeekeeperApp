# ==================================================
# EmbedLocales.cmake
# --------------------------------------------------
# Generates a C++ source file containing every
# resources/locales/*.json as a byte array, so the
# built-in languages can never be missing or out of
# date at run time (e.g. a stale copy of "resources"
# next to the executable).
#
# Run as a script:
#   cmake -DLOCALES_DIR=<dir> -DOUTPUT=<file.cpp> -P EmbedLocales.cmake
# ==================================================

if(NOT LOCALES_DIR OR NOT OUTPUT)
    message(FATAL_ERROR "EmbedLocales.cmake needs LOCALES_DIR and OUTPUT")
endif()

file(GLOB locale_files "${LOCALES_DIR}/*.json")
list(SORT locale_files)

set(arrays "")
set(entries "")
set(count 0)

foreach(file IN LISTS locale_files)
    get_filename_component(tag "${file}" NAME_WE)
    string(MAKE_C_IDENTIFIER "${tag}" ident)

    file(READ "${file}" hex HEX)
    string(LENGTH "${hex}" hex_length)
    math(EXPR size "${hex_length} / 2")

    # 0x.. bytes, 24 per line (keeps lines short for MSVC;
    # CMake regex has no {n} repeat, so chunk by substring).
    set(bytes "")
    set(offset 0)

    while(offset LESS hex_length)
        string(SUBSTRING "${hex}" ${offset} 48 chunk)
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," chunk "${chunk}")
        string(APPEND bytes "        ${chunk}\n")
        math(EXPR offset "${offset} + 48")
    endwhile()

    string(APPEND arrays
        "    const unsigned char locale_${ident}[] =\n"
        "    {\n${bytes}    };\n\n")

    string(APPEND entries
        "        { \"${tag}\", locale_${ident}, ${size}u },\n")

    math(EXPR count "${count} + 1")
endforeach()

if(count EQUAL 0)
    message(FATAL_ERROR "No locale files found in ${LOCALES_DIR}")
endif()

string(CONCAT content
"// Generated by cmake/EmbedLocales.cmake - do not edit.\n"
"// Source: resources/locales/*.json\n\n"
"#include \"localization/EmbeddedLocales.h\"\n\n"
"namespace\n{\n"
"${arrays}"
"    const EmbeddedLocales::Entry entries[] =\n"
"    {\n"
"${entries}"
"    };\n"
"}\n\n"
"namespace EmbeddedLocales\n{\n"
"    const Entry* All(int& count)\n"
"    {\n"
"        count = ${count};\n"
"        return entries;\n"
"    }\n"
"}\n")

# Only touch the file when the content changed (avoids
# needless recompiles).
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" previous)
endif()

if(NOT "${previous}" STREQUAL "${content}")
    file(WRITE "${OUTPUT}" "${content}")
endif()
